# ========================================================
# НАСТРОЙКИ TELEGRAM БОТА И УВЕДОМЛЕНИЙ
# ========================================================

# Токен вашего бота от @BotFather (например: 7123456789:AAFxxx...)
BOT_TOKEN=

# Ваш личный числовой Telegram ID от @userinfobot (куда присылать уведомления о записях)
MASTER_TELEGRAM_ID=

# Публичный адрес сайта (после деплоя на Vercel или Render)
WEB_APP_URL=http://localhost:8000

# PIN-код для входа в кабинет мастера через браузер
ADMIN_PIN=1234

# Имя мастера и адрес студии
MASTER_NAME=Мастер маникюра
STUDIO_ADDRESS=г. Москва, ул. Примерная (уточняйте при записи)
